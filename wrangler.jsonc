// Cloudflare Workers config for the SvelteKit app (#218).
// Secrets are set with `wrangler secret bulk` (see scripts/cf-secrets.sh), not here.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "todzz",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// D1 (#232). Migrations come from `drizzle-kit generate` (schema in src/lib/server/db/schema).
	// Nothing reads it yet: production still runs on Hasura until the cut-over (#234).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "todzz",
			"database_id": "e108c6bb-329b-4d5a-8909-62d3dab343eb",
			"migrations_dir": "drizzle"
		}
	],
	"env": {
		// `wrangler … --env staging`: worker `todzz-staging` with its own copy of the data.
		"staging": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "todzz-staging",
					"database_id": "cdbc48e7-ba8f-4f53-97b5-2d13486d90f8",
					"migrations_dir": "drizzle"
				}
			]
		}
	}
}
